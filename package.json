{
  "name": "@klaybloom/fly-ui",
  "version": "0.1.0",
  "description": "Fly UI: quiet, content-first React components for admin systems and dashboards, plus the Fly UI design tokens.",
  "license": "MIT",
  "author": "klaybloom",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/components.css",
    "./base.css": "./dist/base.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node test/smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.24.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klaybloom/fly-ui.git"
  },
  "homepage": "https://github.com/klaybloom/fly-ui#readme",
  "keywords": [
    "fly-ui",
    "react",
    "design-system",
    "components",
    "design-tokens",
    "admin",
    "dashboard"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
